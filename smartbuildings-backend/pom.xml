    <profiles>
        <!-- 使用本机已完整缓存的 surefire 版本，避免因 3.5.4 缺 surefire-common 依赖导致测试无法运行 -->
        <profile>
            <id>offline-surefire</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.5</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>